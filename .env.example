# Copy to .env and fill in real values. Never commit .env itself.

# --- CognoDB (second workspace, dedicated to this benchmark -- see
# README methodology section for why it's a separate signup from any
# other project's instance) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free ---
AURADB_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURADB_USER=neo4j
AURADB_PASSWORD=

# --- Self-hosted Neo4j (docker/compose.yml) ---
SELF_HOSTED_NEO4J_URI=bolt://localhost:7687
SELF_HOSTED_NEO4J_USER=neo4j
SELF_HOSTED_NEO4J_PASSWORD=devpassword

# --- Self-hosted Memgraph (docker/compose.yml) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- Self-hosted ArangoDB (docker/compose.yml) ---
ARANGODB_URI=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=devpassword
ARANGODB_DATABASE=graphparity
