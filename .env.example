# GraphParity environment configuration -- EXAMPLE FILE, safe to commit.
#
# Copy this to `.env` (gitignored) and fill in real values. `.env` is
# read by PlatformsSettings (config/settings.py) via pydantic-settings'
# GRAPHPARITY_ env-var prefix and `__` nested delimiter.
#
# IMPORTANT -- pydantic-settings quirk: for any platform block below
# where you set even ONE variable, you must set ALL FIVE for that
# block (URI, USERNAME, PASSWORD, NAME, PROTOCOL). Partial overrides
# are not merged onto the code-level defaults -- see the module
# docstring in config/settings.py for why. If you leave a platform's
# entire block untouched (commented out / unset), it silently falls
# back to a safe default aimed at localhost Docker, which is fine for
# every self-hosted platform in docker/compose.yml.
#
# NEVER put real production credentials in this file -- this is the
# EXAMPLE. Real values only ever go in `.env`.

# ── CognoDB (managed cloud -- the only live, confirmed instance) ─────
# Confirmed instance specs: bolt+s over Bolt/Cypher, free c0 tier,
# 0.5 vCPU / 512MB / 1GB disk, us-east4, 50,000 max result rows.
GRAPHPARITY_COGNODB__NAME=cognodb
GRAPHPARITY_COGNODB__PROTOCOL=bolt
GRAPHPARITY_COGNODB__URI=bolt+s://your-instance-id.bravo.databases.cognodb.com:7687
GRAPHPARITY_COGNODB__USERNAME=cognodb
GRAPHPARITY_COGNODB__PASSWORD=replace-with-generated-password

# ── Neo4j AuraDB Free (managed cloud) ─────────────────────────────────
# Not yet signed up for this one -- fill in once an AuraDB Free
# instance exists. Leaving this whole block unset is also fine; it
# falls back to a clearly-fake placeholder default that will fail
# CONNECTION_FAILED loudly rather than silently pointing anywhere real.
GRAPHPARITY_AURA__NAME=aura
GRAPHPARITY_AURA__PROTOCOL=bolt
GRAPHPARITY_AURA__URI=bolt+s://your-aura-instance-id.databases.neo4j.io:7687
GRAPHPARITY_AURA__USERNAME=neo4j
GRAPHPARITY_AURA__PASSWORD=replace-with-generated-password

# ── Self-hosted Neo4j (docker/compose.yml, resource-capped) ──────────
# Matches docker/compose.yml's NEO4J_AUTH=neo4j/devpassword and the
# 7687 host port mapping. No signup needed -- change only if you edit
# compose.yml's auth or port.
GRAPHPARITY_SELF_HOSTED_NEO4J__NAME=self_hosted_neo4j
GRAPHPARITY_SELF_HOSTED_NEO4J__PROTOCOL=bolt
GRAPHPARITY_SELF_HOSTED_NEO4J__URI=bolt://localhost:7687
GRAPHPARITY_SELF_HOSTED_NEO4J__USERNAME=neo4j
GRAPHPARITY_SELF_HOSTED_NEO4J__PASSWORD=devpassword

# ── Self-hosted Memgraph (docker/compose.yml, resource-capped) ───────
# Matches compose.yml's shifted host port (7688 -> container 7687,
# since 7687 is already taken by the neo4j service above).
GRAPHPARITY_MEMGRAPH__NAME=memgraph
GRAPHPARITY_MEMGRAPH__PROTOCOL=bolt
GRAPHPARITY_MEMGRAPH__URI=bolt://localhost:7688
GRAPHPARITY_MEMGRAPH__USERNAME=memgraph
GRAPHPARITY_MEMGRAPH__PASSWORD=devpassword

# ── Self-hosted ArangoDB (docker/compose.yml, resource-capped) ───────
# Matches compose.yml's ARANGO_ROOT_PASSWORD=devpassword. DATABASE is
# required for this platform (protocol=http) -- ArangoDB has no
# implicit default database the way Bolt platforms do.
GRAPHPARITY_ARANGODB__NAME=arangodb
GRAPHPARITY_ARANGODB__PROTOCOL=http
GRAPHPARITY_ARANGODB__URI=http://localhost:8529
GRAPHPARITY_ARANGODB__USERNAME=root
GRAPHPARITY_ARANGODB__PASSWORD=devpassword
GRAPHPARITY_ARANGODB__DATABASE=graphparity
