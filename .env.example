# GraphParity environment configuration
#
# Copy this file to .env and replace the values for the platforms
# you actually have access to.
#
# Never commit .env.
#
# Platform-specific variables use the naming convention:
# GRAPHPARITY_<PLATFORM>__<FIELD>
#
# Platforms:
#   - COGNODB
#   - AURA
#   - SELF_HOSTED_NEO4J
#   - MEMGRAPH
#   - ARANGODB


# -----------------------------------------------------------------------------
# CognoDB
# -----------------------------------------------------------------------------
#
# Required for the benchmark.
#
# Create a CognoDB instance and replace the URI/password with the
# credentials provided by CognoDB.

GRAPHPARITY_COGNODB__URI=bolt+s://<your-instance>.databases.cognodb.com:7687
GRAPHPARITY_COGNODB__USERNAME=cognodb
GRAPHPARITY_COGNODB__PASSWORD=<your-generated-password>


# -----------------------------------------------------------------------------
# Neo4j AuraDB
# -----------------------------------------------------------------------------

GRAPHPARITY_AURA__URI=bolt+s://<your-aura-instance>.databases.neo4j.io:7687
GRAPHPARITY_AURA__USERNAME=neo4j
GRAPHPARITY_AURA__PASSWORD=<your-aura-password>


# -----------------------------------------------------------------------------
# Self-hosted Neo4j
# -----------------------------------------------------------------------------

GRAPHPARITY_SELF_HOSTED_NEO4J__URI=bolt://localhost:7687
GRAPHPARITY_SELF_HOSTED_NEO4J__USERNAME=neo4j
GRAPHPARITY_SELF_HOSTED_NEO4J__PASSWORD=devpassword


# -----------------------------------------------------------------------------
# Memgraph
# -----------------------------------------------------------------------------

GRAPHPARITY_MEMGRAPH__URI=bolt://localhost:7688
GRAPHPARITY_MEMGRAPH__USERNAME=memgraph
GRAPHPARITY_MEMGRAPH__PASSWORD=devpassword


# -----------------------------------------------------------------------------
# ArangoDB
# -----------------------------------------------------------------------------

GRAPHPARITY_ARANGODB__URI=http://localhost:8529
GRAPHPARITY_ARANGODB__USERNAME=root
GRAPHPARITY_ARANGODB__PASSWORD=devpassword
GRAPHPARITY_ARANGODB__DATABASE=graphparity